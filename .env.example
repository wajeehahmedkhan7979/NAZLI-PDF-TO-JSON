# Application
PORT=3000
NODE_ENV=development
API_KEY=local-dev-key-12345

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pdf-pipeline?schema=public"

# Redis / Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=20
MAX_PAGES=100

# OCR
TESSERACT_LANG=jpn
MIN_OCR_CONFIDENCE=0.6

# AI Translation (Optional fallback)
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
